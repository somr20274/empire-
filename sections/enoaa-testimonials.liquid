<div class="enoaa-section" style="--enoaa-pad: {{ section.settings.padding }}px;">
  <div class="enoaa-container">
    {%- if section.settings.title != blank -%}<h2 class="enoaa-h2 h4">{{ section.settings.title }}</h2>{%- endif -%}
    <div class="enoaa-reviews-row">
      {%- for block in section.blocks -%}
        <article class="enoaa-tcard" {{ block.shopify_attributes }}>
          <div class="enoaa-tcard__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 78vw, 25vw', widths: '350,500,700' }}
            {%- else -%}
              <div class="enoaa-ph">Ajoutez une photo</div>
            {%- endif -%}
          </div>
          <div class="enoaa-tcard__body">
            <div class="enoaa-tcard__head"><span>{{ block.settings.name | escape }}</span><span class="enoaa-stars">★★★★★</span></div>
            {%- if block.settings.verified -%}<span class="enoaa-tcard__verified">✓ Achat vérifié</span>{%- endif -%}
            <div class="enoaa-tcard__text">{{ block.settings.text }}</div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ENOAA – Témoignages",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Titre", "default": "Ce qu'en disent celles qui ont toujours froid aux pieds" },
    { "type": "range", "id": "padding", "label": "Espacement vertical", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Témoignage",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo de la cliente" },
        { "type": "text", "id": "name", "label": "Prénom, âge", "default": "[PRÉNOM], [ÂGE]" },
        { "type": "checkbox", "id": "verified", "label": "Afficher « Achat vérifié »", "default": true },
        { "type": "richtext", "id": "text", "label": "Avis", "default": "<p>[AVIS CLIENT]</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "ENOAA – Témoignages", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" } ] }
  ]
}
{% endschema %}
