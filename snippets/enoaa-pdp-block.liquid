{%- comment -%}
  ENOAA – blocs personnalisés de la fiche produit (rendus depuis product-info.liquid).
  Tous les textes sont modifiables dans l'éditeur de thème.
{%- endcomment -%}
{%- case block.type -%}

  {%- when 'enoaa_intro' -%}
    <div class="enoaa-intro" {{ block.shopify_attributes }}>
      {%- if block.settings.pill != blank -%}<span class="enoaa-pill enoaa-pill--dark">{{ block.settings.pill | escape }}</span>{%- endif -%}
      {%- if block.settings.headline != blank -%}<p class="enoaa-intro__headline">{{ block.settings.headline }}</p>{%- endif -%}
      {%- if block.settings.proof != blank -%}
        <div class="enoaa-intro__proof">
          {%- if block.settings.avatar != blank -%}{{ block.settings.avatar | image_url: width: 80 | image_tag: class: 'enoaa-intro__avatar', loading: 'lazy' }}{%- endif -%}
          <span>{{ block.settings.proof }}</span>
        </div>
      {%- endif -%}
      {%- if block.settings.rating_text != blank -%}
        <div class="enoaa-intro__rating"><span class="enoaa-stars" aria-hidden="true">★★★★★</span> <span>{{ block.settings.rating_text }}</span></div>
      {%- endif -%}
    </div>

  {%- when 'enoaa_benefits' -%}
    <ul class="enoaa-benefits" {{ block.shopify_attributes }}>
      {%- for i in (1..4) -%}
        {%- assign key = 'benefit_' | append: i -%}
        {%- if block.settings[key] != blank -%}
          <li><span class="enoaa-benefits__icon" aria-hidden="true">{% if i == 4 %}↔{% else %}♡{% endif %}</span>{{ block.settings[key] }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

  {%- when 'enoaa_bundle' -%}
    {%- liquid
      assign size_option = product.options_with_values | where: 'name', block.settings.option_name | first
      assign base_variant = product.selected_or_first_available_variant
      assign pairs_per_pack = block.settings.pairs_per_pack | at_least: 1
      assign selected_card = block.settings.selected_card
    -%}
    <div class="enoaa-bundle" data-enoaa-bundle data-form="{{ product_form_id }}" {{ block.shopify_attributes }}>
      {%- if block.settings.hide_variant_picker -%}<style>.product-info__variant-picker { display: none !important; }</style>{%- endif -%}
      {%- for i in (1..3) -%}
        {%- liquid
          assign title_key = 'title_' | append: i
          assign qty_key = 'packs_' | append: i
          assign free_key = 'free_' | append: i
          assign tag_key = 'tag_' | append: i
          assign packs = block.settings[qty_key] | default: 0
          if block.settings[title_key] == blank or packs < 1
            continue
          endif
          assign free = block.settings[free_key] | default: 0 | at_most: packs
          assign paid = packs | minus: free
          assign card_price = base_variant.price | times: paid
          assign card_compare = base_variant.price | times: packs
          assign pairs = packs | times: pairs_per_pack
          assign per_pair = card_price | divided_by: pairs
        -%}
        <div class="enoaa-bundle__card{% if i == selected_card %} is-selected{% endif %}" data-card data-packs="{{ packs }}" role="radio" tabindex="0" aria-checked="{% if i == selected_card %}true{% else %}false{% endif %}">
          {%- if block.settings[tag_key] != blank -%}<span class="enoaa-bundle__tag">{{ block.settings[tag_key] | escape }}</span>{%- endif -%}
          <div class="enoaa-bundle__row">
            <span class="enoaa-bundle__radio" aria-hidden="true"></span>
            <span class="enoaa-bundle__main">
              <span class="enoaa-bundle__label">{{ block.settings[title_key] | escape }}</span>
              <span class="enoaa-bundle__sub">{{ per_pair | money }} la paire</span>
            </span>
            <span class="enoaa-bundle__price">
              <strong>{{ card_price | money }}</strong>
              {%- if card_compare > card_price -%}<s>{{ card_compare | money }}</s>{%- endif -%}
            </span>
          </div>
          {%- if size_option -%}
            <div class="enoaa-bundle__picks">
              {%- for n in (1..packs) -%}
                <label class="enoaa-bundle__pick">
                  <span>{% if packs > 1 %}{{ block.settings.pack_label | escape }} {{ n }}{% else %}{{ size_option.name | escape }}{% endif %}</span>
                  <select data-pack-select aria-label="{{ size_option.name | escape }} {{ n }}">
                    {%- for v in product.variants -%}
                      <option value="{{ v.id }}" {% if v.id == base_variant.id %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title | escape }}</option>
                    {%- endfor -%}
                  </select>
                </label>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.settings.contents != blank -%}
            <div class="enoaa-bundle__contents">
              {%- assign items = block.settings.contents | split: ',' -%}
              {%- for item in items -%}
                {%- assign parts = item | split: ':' -%}
                <span><i style="background: {{ parts[1] | strip | default: '#ccc' }}"></i>{{ packs }}x {{ parts[0] | strip }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  {%- when 'enoaa_shipping' -%}
    {%- liquid
      assign now = 'now' | date: '%s' | plus: 0
      assign ship_seconds = block.settings.prep_days | times: 86400
      assign ship_ts = now | plus: ship_seconds
      assign dow = ship_ts | date: '%w' | plus: 0
      if dow == 6
        assign ship_ts = ship_ts | plus: 172800
      elsif dow == 0
        assign ship_ts = ship_ts | plus: 86400
      endif
      assign days_fr = 'dim.,lun.,mar.,mer.,jeu.,ven.,sam.' | split: ','
      assign months_fr = 'janv.,févr.,mars,avr.,mai,juin,juil.,août,sept.,oct.,nov.,déc.' | split: ','
      assign d_i = ship_ts | date: '%w' | plus: 0
      assign m_i = ship_ts | date: '%m' | plus: 0 | minus: 1
    -%}
    <div class="enoaa-shipping" {{ block.shopify_attributes }}>
      <span>🚚 {{ block.settings.ship_label | escape }} <strong>{{ days_fr[d_i] }} {{ ship_ts | date: '%-d' }} {{ months_fr[m_i] }}</strong></span>
      {%- if block.settings.right_text != blank -%}<span>📦 {{ block.settings.right_text | escape }}</span>{%- endif -%}
    </div>

  {%- when 'enoaa_guarantee' -%}
    <div class="enoaa-guarantee" {{ block.shopify_attributes }}>
      <div class="enoaa-guarantee__seal" aria-hidden="true">
        {%- if block.settings.seal_image != blank -%}
          {{ block.settings.seal_image | image_url: width: 120 | image_tag: loading: 'lazy' }}
        {%- else -%}
          <span>{{ block.settings.seal_text | escape }}</span>
        {%- endif -%}
      </div>
      <div>
        <p class="enoaa-guarantee__title">{{ block.settings.title | escape }}</p>
        <div class="enoaa-guarantee__text">{{ block.settings.text }}</div>
      </div>
    </div>

{%- endcase -%}
